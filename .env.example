# ===== Core =====
APP_URL=http://localhost:3000
DATABASE_URL=postgres://mila:mila@localhost:5432/mila
# 32+ random bytes, hex. Used to HMAC session tokens and IP hashes. Generate: openssl rand -hex 32
SESSION_SECRET=
# 32 bytes hex. Reserved for field-level encryption of sensitive data. Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# ===== AI providers (server-side only). Leave blank to disable a provider =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# provider:model pairs allowed for the FREE plan fallback default
DEFAULT_MODEL=anthropic:claude-sonnet-5-5

# ===== Moderation =====
# If true, chat requests are refused when no moderation backend is configured (OpenAI key needed)
MODERATION_REQUIRED=true

# ===== Email (verification, password reset, consent receipts) =====
RESEND_API_KEY=
EMAIL_FROM=

# ===== Payments (NOT IMPLEMENTED YET - see README) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ISRAELI_INVOICE_PROVIDER_API_KEY=

# ===== Admin bootstrap (one-time; no hardcoded admin passwords) =====
# Run: npm run migrate, register a normal user, then set role via SQL:
#   UPDATE users SET role='super_admin' WHERE email='you@example.com';
